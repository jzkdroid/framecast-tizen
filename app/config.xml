<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://framecast.local/tv" version="1.0.0" viewmodes="maximized">
    <tizen:application id="FrmCastTV1.FrameCast" package="FrmCastTV1" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>FrameCast</name>
    <description>IPTV player for Xtream Codes providers</description>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>

    <!-- IPTV providers live on arbitrary hosts, so the app may *fetch* from anywhere.
         No tizen:allow-navigation: the app never navigates away from its own page. -->
    <access origin="*" subdomains="true"/>
    <!-- Without an explicit policy, Tizen 10 applies object-src 'none', which blocks the
         <object type="application/avplayer"> that AVPlay renders into.
         Code and styles come only from the app package (no inline script or style), so text
         from the provider (channel names, guide titles) can never run as code. Network data
         (API, guide, logos, streams) may come from any host. -->
    <tizen:content-security-policy>default-src 'self'; script-src 'self'; style-src 'self'; img-src * data: blob:; media-src * blob:; connect-src *; object-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'</tizen:content-security-policy>

    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>
</widget>
